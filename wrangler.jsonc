{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finocus-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",

  "observability": { "enabled": true },

  // Every 10 minutes. Each tick does ONE step — the free plan allows 50
  // subrequests per invocation and a full pass costs ~200, so the work is
  // sharded (see refresh.ts). MUST MATCH `CRON_INTERVAL_MS` there: the refresh
  // position is derived from the tick number, so a mismatch silently changes
  // which phase runs when.
  //
  // 10 rather than 15 because prices refresh on EVERY tick while the US
  // extended session is open (04:00–20:00 ET), which sets the dashboard's
  // worst-case staleness at one interval. Off-session ticks run the rotation:
  // market + 14 investor batches + consensus + calendar, and the 8-hour
  // overnight window is 48 ticks, so every phase is reached at least twice a
  // night. 13F filings land in four windows a year (mid Feb/May/Aug/Nov); the
  // rest of the time investor steps write nothing at all.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Created with:  npx wrangler kv namespace create CACHE
  // `preview_id` points at the same namespace on purpose: `wrangler dev --remote`
  // needs one, and everything cached here is public market data that the refresh
  // job rewrites idempotently — so there is nothing a dev run could corrupt.
  // Split it out if that ever stops being true.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "490debcf74864b0aacf565616f0db4de",
      "preview_id": "490debcf74864b0aacf565616f0db4de"
    }
  ]

  // Secrets are NOT declared here — they are set out of band and never committed:
  //   npx wrangler secret put FRED_API_KEY
  //   npx wrangler secret put ADMIN_TOKEN     (optional, guards /admin/refresh)
}
